<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    # Block HTTrack and similar tools
    RewriteCond %{HTTP_USER_AGENT} ^HTTrack [OR]
    RewriteCond %{HTTP_USER_AGENT} ^SiteSucker [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebZip [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebCopier [OR]
    RewriteCond %{HTTP_USER_AGENT} ^Zeus [OR]
    RewriteCond %{HTTP_USER_AGENT} ^Wget [OR]
    RewriteCond %{HTTP_USER_AGENT} ^Teleport [OR]
    RewriteCond %{HTTP_USER_AGENT} ^ia_archiver [OR]
    RewriteCond %{HTTP_USER_AGENT} ^Offline\ Explorer [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebCapture [OR]
    RewriteCond %{HTTP_USER_AGENT} ^PageGrabber [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebAuto [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebWhacker [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebZIP [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebSauger [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebStripper [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebCopier [OR]
    RewriteCond %{HTTP_USER_AGENT} ^NetAnts [OR]
    RewriteCond %{HTTP_USER_AGENT} ^Download\ Demon [OR]
    RewriteCond %{HTTP_USER_AGENT} ^GetRight [OR]
    RewriteCond %{HTTP_USER_AGENT} ^Go!Zilla [OR]
    RewriteCond %{HTTP_USER_AGENT} ^ReGet [OR]
    RewriteCond %{HTTP_USER_AGENT} ^FlashGet [OR]
    RewriteCond %{HTTP_USER_AGENT} ^Image\ Stripper [OR]
    RewriteCond %{HTTP_USER_AGENT} ^Image\ Sucker [OR]
    RewriteCond %{HTTP_USER_AGENT} ^MIDown\ tool [OR]
    RewriteCond %{HTTP_USER_AGENT} ^Web\ Image\ Collector [OR]
    RewriteCond %{HTTP_USER_AGENT} ^Web\ Sucker [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebFetch [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebPictures [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebReaper [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebSauger [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebSnake [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebSpider [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebVac [OR]
    RewriteCond %{HTTP_USER_AGENT} ^WebZIP [OR]
    RewriteCond %{HTTP_USER_AGENT} ^Wget [OR]
    RewriteCond %{HTTP_USER_AGENT} ^Zeus
    RewriteRule ^.* - [F,L]

    # Block image hotlinking
    RewriteCond %{HTTP_REFERER} !^http://erp.orangenexa.com/.*$      [NC]
    RewriteCond %{HTTP_REFERER} !^http://erp.orangenexa.com$      [NC]
    RewriteCond %{HTTP_REFERER} !^http://www.erp.orangenexa.com/.*$      [NC]
    RewriteCond %{HTTP_REFERER} !^http://www.erp.orangenexa.com$      [NC]
    RewriteCond %{HTTP_REFERER} !^https://erp.orangenexa.com/.*$      [NC]
    RewriteCond %{HTTP_REFERER} !^https://erp.orangenexa.com$      [NC]
    RewriteCond %{HTTP_REFERER} !^https://www.erp.orangenexa.com/.*$      [NC]
    RewriteCond %{HTTP_REFERER} !^https://www.erp.orangenexa.com$      [NC]
    RewriteRule .*\.(jpg|jpeg|gif|png|bmp|webp)$ - [F,NC]
</IfModule>

# Enable caching for 3 months
<IfModule mod_expires.c>
    ExpiresActive On

    # Default expiration: 3 months
    ExpiresDefault "access plus 3 months"

    # Specific file type expirations
    ExpiresByType image/jpg "access plus 3 months"
    ExpiresByType image/jpeg "access plus 3 months"
    ExpiresByType image/gif "access plus 3 months"
    ExpiresByType image/png "access plus 3 months"
    ExpiresByType image/webp "access plus 3 months"
    ExpiresByType text/css "access plus 3 months"
    ExpiresByType application/javascript "access plus 3 months"
    ExpiresByType application/x-javascript "access plus 3 months"
    ExpiresByType text/javascript "access plus 3 months"
    ExpiresByType font/woff "access plus 3 months"
    ExpiresByType font/woff2 "access plus 3 months"
    ExpiresByType application/font-woff "access plus 3 months"
    ExpiresByType application/font-woff2 "access plus 3 months"
    ExpiresByType image/svg+xml "access plus 3 months"
</IfModule>

<IfModule mod_headers.c>
    # Set Cache-Control header for 3 months
    <FilesMatch "\.(jpg|jpeg|gif|png|webp|css|js|woff|woff2|svg)$">
        Header set Cache-Control "max-age=7884000, public"
    </FilesMatch>
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit